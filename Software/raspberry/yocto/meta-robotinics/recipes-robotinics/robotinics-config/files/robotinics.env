ROBOTINICS_SERIAL_PORT=/dev/ttyACM0
ROBOTINICS_SERIAL_BAUD=115200
ROBOTINICS_LLM_PROVIDER=openai-compatible
ROBOTINICS_LLM_URL=
ROBOTINICS_LLM_MODEL=
ROBOTINICS_LLM_TOKEN=
ROBOTINICS_SEARCH_URL=
ROBOTINICS_SEARCH_TOKEN=
ROBOTINICS_DOCS_PATH=/opt/robotinics/docs
ROBOTINICS_STATE_PATH=/var/lib/robotinics
ROBOTINICS_TTS_ENDPOINT=https://api.openai.com/v1/audio/speech
ROBOTINICS_TTS_MODEL=gpt-4o-mini-tts
ROBOTINICS_TTS_VOICE=alloy
ROBOTINICS_TTS_LANGUAGE=pt-BR
ROBOTINICS_TTS_SPEED=1.0
ROBOTINICS_TTS_TOKEN=
ROBOTINICS_AUDIO_PLAYER=/usr/bin/aplay
